<odoo>
    <data>
        <record id="view_report_pos_order_pivot_with_tax" model="ir.ui.view">
            <field name="name">report.pos.order.pivot.with.tax</field>
            <field name="model">report.pos.order</field>
            <field name="inherit_id" ref="point_of_sale.view_report_pos_order_pivot"/>
            <field name="arch" type="xml">
              <xpath expr="//pivot" position="replace">
                <pivot string="Point of Sale Analysis" sample="1">
                    <field name="company_id" type="col"/>
                    <field name="date" interval="month" type="row"/>
                    <field name="total_tax_amount" type="measure"/>
                    <field name="subtotal_untaxed" type="measure"/>
                    <field name="price_total" type="measure"/>
                </pivot>
              </xpath>
            </field>
        </record>
    </data>
</odoo>